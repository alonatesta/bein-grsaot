# Copy to .env.local for local dev, and set these in Vercel → Project → Settings → Environment Variables

# The Gmail account the postcards are sent FROM
GMAIL_USER=you@gmail.com

# A Google "App Password" (16 chars) — NOT your normal Gmail password.
# Create at: Google Account → Security → 2-Step Verification → App passwords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional: display name shown as the sender
MAIL_FROM_NAME=בין גרסאות

# Optional: silently copy every postcard to your own address
# MAIL_BCC=you@gmail.com
